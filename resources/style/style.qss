/* ============================================
   LLMChat - Theme-neutral QSS
   Uses transparent / rgba colors so ElaTheme
   dark/light mode paints through correctly.
   ============================================ */

/* === Left Panel === */
#leftPanel {
    background-color: rgba(128, 128, 128, 0.06);
    border-right: 1px solid rgba(128, 128, 128, 0.15);
}

/* === Buttons === */
#newChatButton {
    background-color: #10a37f;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}
#newChatButton:hover {
    background-color: #0d8c6d;
}

#settingsButton {
    background-color: transparent;
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 6px;
    padding: 8px;
    font-size: 13px;
}
#settingsButton:hover {
    background-color: rgba(128, 128, 128, 0.1);
}

/* === Session List === */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    font-size: 13px;
}
QListWidget::item {
    padding: 10px 12px;
    border-radius: 6px;
    margin: 2px 4px;
}
QListWidget::item:selected {
    background-color: rgba(128, 128, 128, 0.15);
}
QListWidget::item:hover {
    background-color: rgba(128, 128, 128, 0.08);
}

/* === Chat Area === */
#chatScrollArea {
    background-color: transparent;
    border: none;
}
#messageContainer {
    background-color: transparent;
}

/* === Message Bubbles === */
#userBubble {
    background-color: rgba(16, 163, 127, 0.15);
    border-radius: 12px;
}
#assistantBubble {
    background-color: rgba(128, 128, 128, 0.10);
    border-radius: 12px;
}
#userBubbleContent, #assistantBubbleContent {
    font-size: 14px;
}
#userRoleLabel {
    color: #10a37f;
    font-size: 11px;
}
#assistantRoleLabel {
    font-size: 11px;
}

/* === Input Bar === */
#inputBar {
    background-color: transparent;
    border-top: 1px solid rgba(128, 128, 128, 0.15);
}
#chatInput {
    background-color: rgba(128, 128, 128, 0.06);
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
}
#chatInput:focus {
    border-color: #10a37f;
}
#sendButton {
    background-color: #10a37f;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: bold;
}
#sendButton:hover {
    background-color: #0d8c6d;
}
#sendButton:disabled {
    background-color: rgba(128, 128, 128, 0.2);
}

/* === Status Label === */
#statusLabel {
    font-size: 12px;
    padding: 4px 20px;
}

/* === Scrollbar === */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(128, 128, 128, 0.3);
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(128, 128, 128, 0.5);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* === Settings Dialog === */
QTabWidget::pane {
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 4px;
}
QTabBar::tab {
    padding: 8px 20px;
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    background: rgba(128, 128, 128, 0.06);
    font-size: 13px;
}
QTabBar::tab:selected {
    background: transparent;
}

/* === Provider Combo === */
#providerCombo {
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 6px;
    padding: 6px 8px;
    background: transparent;
    font-size: 13px;
}

/* === Splitter === */
QSplitter::handle {
    background-color: rgba(128, 128, 128, 0.15);
}
