/* ============================================
   LLMChat - Theme-adaptive QSS
   Uses transparent / rgba / inherit colors
   so ElaTheme dark/light mode works correctly.
   ============================================ */

/* === Left Panel === */
#leftPanel {
    background-color: rgba(128, 128, 128, 0.06);
    border-right: 1px solid rgba(128, 128, 128, 0.15);
}

/* === Buttons === */
#newChatButton {
    background-color: #10a37f;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}
#newChatButton:hover {
    background-color: #0d8c6d;
}

#settingsButton {
    background-color: transparent;
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 6px;
    padding: 8px;
    font-size: 13px;
}
#settingsButton:hover {
    background-color: rgba(128, 128, 128, 0.1);
}

/* === Session List === */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    font-size: 13px;
}
QListWidget::item {
    padding: 10px 12px;
    border-radius: 6px;
    margin: 2px 4px;
}
QListWidget::item:selected {
    background-color: rgba(128, 128, 128, 0.15);
}
QListWidget::item:hover {
    background-color: rgba(128, 128, 128, 0.08);
}

/* === Chat Area === */
#chatScrollArea {
    background-color: transparent;
    border: none;
}
#messageContainer {
    background-color: transparent;
}

/* === Message Bubbles === */
#userBubble {
    background-color: rgba(16, 163, 127, 0.15);
    border-radius: 12px;
}
#assistantBubble {
    background-color: rgba(128, 128, 128, 0.10);
    border-radius: 12px;
}
/* 收藏状态：通过 dynamic property "favorite=true" 触发，避免内联 setStyleSheet
   覆盖 #userBubble / #assistantBubble 的背景色规则。 */
#userBubble[favorite="true"], #assistantBubble[favorite="true"] {
    border: 2px solid #ffc107;
}
#userBubbleContent, #assistantBubbleContent {
    font-size: 14px;
}
#userRoleLabel {
    color: #10a37f;
    font-size: 11px;
}
#assistantRoleLabel {
    font-size: 11px;
}

/* === Input Bar === */
#inputBar {
    background-color: transparent;
    border-top: 1px solid rgba(128, 128, 128, 0.15);
}
#chatInput {
    background-color: rgba(128, 128, 128, 0.06);
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 14px;
}
#chatInput:focus {
    border-color: #10a37f;
}
#sendButton {
    background-color: #10a37f;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: bold;
}
#sendButton:hover {
    background-color: #0d8c6d;
}
#sendButton:disabled {
    background-color: rgba(128, 128, 128, 0.2);
    color: rgba(128, 128, 128, 0.5);
}

/* === Status Label === */
#statusLabel {
    font-size: 12px;
    padding: 4px 20px;
}

/* === Scrollbar === */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(128, 128, 128, 0.3);
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(128, 128, 128, 0.5);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* === Settings Pages === */
QTabWidget::pane {
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 4px;
}
QTabBar::tab {
    padding: 8px 20px;
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    background: rgba(128, 128, 128, 0.06);
    font-size: 13px;
}
QTabBar::tab:selected {
    background: transparent;
}

/* === Provider Combo === */
#providerCombo {
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 6px;
    padding: 6px 8px;
    background: transparent;
    font-size: 13px;
}

/* === Splitter === */
QSplitter::handle {
    background-color: rgba(128, 128, 128, 0.15);
}

/* === Global text inputs — 确保暗色主题下文字可见 ===
   ElaWidgetTools 控件会自动适配主题，但标准 Qt 控件
   （QPlainTextEdit / QSpinBox / QDoubleSpinBox / QLineEdit / QTextEdit）
   需要设置透明背景和继承前景色。 */
QPlainTextEdit, QSpinBox, QDoubleSpinBox, QLineEdit {
    background-color: rgba(128, 128, 128, 0.06);
    border: 1px solid rgba(128, 128, 128, 0.2);
    border-radius: 6px;
    padding: 4px 8px;
}
QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border-color: #10a37f;
}

/* === Settings Page Text ===
   ElaText/ElaLineEdit 等 ElaWidgetTools 控件跟随主题自动变色，
   这里不设置 color，让主题系统接管。 */

/* === Prompt Template Tags === */
#promptTag {
    background: rgba(128, 128, 128, 0.08);
    border: 1px solid rgba(128, 128, 128, 0.15);
    border-radius: 14px;
    padding: 0 12px;
    font-size: 12px;
}
#promptTag:hover {
    background: rgba(16, 163, 127, 0.12);
    border-color: #10a37f;
    color: #10a37f;
}
